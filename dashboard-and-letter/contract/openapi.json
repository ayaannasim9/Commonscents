  "components": {
    "schemas": {
      "ApproveIn": {
        "properties": {
          "helper": {
            "type": "string",
            "title": "Helper",
            "default": "Priya"
          }
        },
        "type": "object",
        "title": "ApproveIn"
      },
      "CaseIn": {
        "properties": {
          "customer": {
            "type": "string",
            "title": "Customer",
            "default": "MRG-4471"
          },
          "source": {
            "type": "string",
            "enum": [
              "slip_post_office",
              "slip_post",
              "counter_verbal",
              "hub_visit",
              "phone",
              "system_flag"
            ],
            "title": "Source"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          },
          "ticks": {
            "items": {
              "type": "string",
              "enum": [
                "worried",
                "scam_call",
                "bill",
                "afford",
                "other"
              ]
            },
            "type": "array",
            "title": "Ticks",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "source",
          "text"
        ],
        "title": "CaseIn"
      },
      "DraftIn": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "DraftIn"
      },
      "EventIn": {
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "scam_transfer",
              "forgotten_subscription",
              "price_rise"
            ],
            "title": "Event"
          }
        },
        "type": "object",
        "required": [
          "event"
        ],
        "title": "EventIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NoteIn": {
        "properties": {
          "note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Note"
          },
          "helper": {
            "type": "string",
