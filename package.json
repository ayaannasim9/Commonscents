{
  "name": "commonscents-learn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/verify.mjs",
    "db:login": "supabase login",
    "db:link": "supabase link",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migration:new": "supabase migration new",
    "db:migrate:local": "supabase migration up",
    "db:plan": "supabase db push --remote --dry-run --skip-vault",
    "db:deploy": "supabase db push --remote --skip-vault",
    "db:history": "supabase migration list --remote",
    "dev:web": "next dev --webpack --hostname 127.0.0.1",
    "dev:dashboard": "dashboard-and-letter/backend/.venv/bin/python -m uvicorn counterpart.app:app --host 127.0.0.1 --port 8000",
    "setup:dashboard": "python3 -m venv dashboard-and-letter/backend/.venv && dashboard-and-letter/backend/.venv/bin/pip install -e 'dashboard-and-letter/backend[dev,pdf]'",
    "test:dashboard": "dashboard-and-letter/backend/.venv/bin/python -m pytest dashboard-and-letter/backend/tests -q",
    "styles:dashboard": "node scripts/build-dashboard-styles.mjs",
    "test:integration": "node scripts/verify-integration.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "3.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
